{
  "version": "0.2.1",
  "configurations": [
    {
      "type": "cppdbg",
      "request": "launch",
      "name": "STM32 Debug (st-util GDB)",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/Debug/Code.elf",
      "preLaunchTask": "Build Project",
      "postDebugTask": "Kill GDB Server",
      "serverStartupTimeout": 10000,
      "stopAtEntry": true,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "arm-none-eabi-gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set architecture",
          "text": "set architecture arm",
          "ignoreFailures": true
        }
      ],
      "miDebuggerServerAddress": "localhost:4242",
      "launchCompleteCommand": "exec-continue"
    },
    {
      "type": "stlinkgdbtarget",
      "request": "launch",
      "name": "STM32 Debug (STM32CubeIDE Extension)",
      "cwd": "${workspaceFolder}",
      "preBuild": "${command:st-stm32-ide-debug-launch.build}",
      "runEntry": "main",
      "imagesAndSymbols": [
        {
          "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
        }
      ],
      "stlink": {
        "adapterSpeed": 50,
        "port": "SWD",
        "reset": "connectUnderReset",
        "haltAfterConnect": true
      }
    }
  ]
}
